# Copy to .env and fill in real values. See config.py for full validation rules.

NODE_ENV=development
LOG_LEVEL=info

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=

# Local dev; on Railway this is injected via ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://whale_alpha:whale_alpha@localhost:5432/whale_alpha
# On Railway this is injected via ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=
SOLANA_CLUSTER=mainnet-beta

JUPITER_API_BASE=https://quote-api.jup.ag/v6
# Defaults to Jupiter's Price API V3 (see
# src/whale_alpha/integrations/price_feed.py for the exact shape). Unlike the
# old V2 endpoint this repo originally targeted, V3 requires an API key —
# get a free one at https://portal.jup.ag. Leave PRICE_FEED_API_KEY blank
# and every price lookup will fail (401), which silently disables
# auto-trading, entry-zone pricing, and price alerts — check the logs for
# "Price feed request failed" if those features go quiet.
PRICE_FEED_API_BASE=
PRICE_FEED_API_KEY=
PRICE_CACHE_TTL_SECONDS=15

# Jupiter Tokens API V2 — used only by the discovery engine's trending-token
# bootstrap source (see DISCOVERY_TRENDING_* below). Leave blank to fall back
# to PRICE_FEED_API_KEY, since one portal.jup.ag key usually covers both.
JUPITER_TOKENS_API_BASE=https://api.jup.ag/tokens/v2
JUPITER_API_KEY=

# 64 hex chars (32 bytes). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=
# At least 16 chars.
JWT_SECRET=

SIGNAL_MIN_WALLETS=3
SIGNAL_WINDOW_MINUTES=30
SIGNAL_MIN_CONFIDENCE=65

DEFAULT_MAX_SLIPPAGE_BPS=150
DEFAULT_MAX_DAILY_TRADES=10
DEFAULT_MAX_DAILY_EXPOSURE_USD=500

# Inbound webhook receiver for whale-wallet ingestion (Helius enhanced
# webhooks by default â€” see src/whale_alpha/integrations/helius_webhook.py).
# Point your indexer's webhook config at http(s)://<host>:<WEBHOOK_PORT><WEBHOOK_PATH>.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhooks/helius
# Shared secret configured as the "Authentication Header" value on the
# Helius webhook dashboard. Required in production.
HELIUS_WEBHOOK_SECRET=

# % price-move alert loop (src/whale_alpha/engines/price_alerts.py)
PRICE_ALERT_INTERVAL_SECONDS=60
PRICE_ALERT_MIN_COOLDOWN_MINUTES=15

# Whale Wallet Discovery & Intelligence Engine (src/whale_alpha/engines/discovery.py)
# The only automated path that ever adds/removes whale wallets. See
# docs/ARCHITECTURE.md for the full pipeline.
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL_SECONDS=900
DISCOVERY_MIN_TRACKED_WALLETS=500
DISCOVERY_MAX_TRACKED_WALLETS=1500
DISCOVERY_MIN_SCORE_TO_APPROVE=55
DISCOVERY_MIN_ROI_30D=0.15
DISCOVERY_MIN_WIN_RATE=0.5
DISCOVERY_MIN_TRADE_COUNT_30D=10
DISCOVERY_MIN_WALLET_AGE_DAYS=14
DISCOVERY_INACTIVITY_TIMEOUT_DAYS=21
DISCOVERY_LOW_SCORE_CYCLES_BEFORE_RETIRE=3
DISCOVERY_CANDIDATE_BATCH_SIZE=50
DISCOVERY_RESCORE_BATCH_SIZE=100
DISCOVERY_CANDIDATE_MIN_REEVAL_HOURS=12
DISCOVERY_SOURCE_TOKEN_LOOKBACK=20
DISCOVERY_MAX_HOLDERS_PER_TOKEN=50
# Independent bootstrap source (Jupiter Tokens API V2) — lets discovery find
# its first wallets with ZERO tracked wallets and zero admin seeding. Without
# this, discovery can only source from holders of tokens your own tracked
# whales already bought, which is a closed loop from zero (see
# src/whale_alpha/engines/discovery.py's discover_candidates docstring).
# Needs JUPITER_API_KEY or PRICE_FEED_API_KEY set (below) — falls back to
# whichever is set, since one portal.jup.ag key usually covers both.
DISCOVERY_TRENDING_ENABLED=true
DISCOVERY_TRENDING_CATEGORY=toptraded
DISCOVERY_TRENDING_INTERVAL=1h
DISCOVERY_TRENDING_TOKEN_LIMIT=20
# Optional. Leave blank to fall back to plain Solana RPC discovery (top
# holders only, no historical wallet PnL) — see
# src/whale_alpha/integrations/wallet_discovery_source.py.
HELIUS_API_KEY=
HELIUS_API_BASE=https://api.helius.xyz
