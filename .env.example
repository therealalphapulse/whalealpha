# Copy to .env and fill in real values. See config.py for full validation rules.

NODE_ENV=development
LOG_LEVEL=info

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=

# Local dev; on Railway this is injected via ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://whale_alpha:whale_alpha@localhost:5432/whale_alpha
# On Railway this is injected via ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=
SOLANA_CLUSTER=mainnet-beta

JUPITER_API_BASE=https://quote-api.jup.ag/v6
PRICE_FEED_API_BASE=
PRICE_FEED_API_KEY=

# 64 hex chars (32 bytes). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=
# At least 16 chars.
JWT_SECRET=

SIGNAL_MIN_WALLETS=3
SIGNAL_WINDOW_MINUTES=30
SIGNAL_MIN_CONFIDENCE=65

DEFAULT_MAX_SLIPPAGE_BPS=150
DEFAULT_MAX_DAILY_TRADES=10
DEFAULT_MAX_DAILY_EXPOSURE_USD=500
