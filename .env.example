BOT_TOKEN=your_telegram_bot_token_here

DATABASE_URL=postgresql://alphapulse:alphapulse_dev_only@localhost:5432/alphapulse

# Real Wallet: required before /realwallet features will work.
# Generate with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
WALLET_MASTER_KEY=

# --- v4 additions (Architecture Bible) ---

# Externalized state (Â§5). Leave unset for local/dev/single-instance â€”
# everything falls back to in-memory (FSM storage, provider cache,
# distributed locks). Required for any multi-replica deployment.
REDIS_URL=

# KMS-ready wallet custody (Â§8). Leave unset (or "env") to keep using
# WALLET_MASTER_KEY directly â€” fine for local/dev. Set to "aws_kms" in
# production and provide WALLET_MASTER_KEY_ENCRYPTED + AWS credentials
# instead; see infra/kms/kms_provider.py.
KMS_PROVIDER=env
# WALLET_MASTER_KEY_ENCRYPTED=
# AWS_REGION=us-east-1

# Webhook mode (Â§3) â€” only required by app_platform.gateway.webhook_entrypoint,
# not by the polling entrypoint or main.py's single-process fallback.
# WEBHOOK_URL=https://your-domain.example.com
# WEBHOOK_SECRET=

# Observability (Â§10). All optional â€” each integration no-ops without
# its corresponding value set.
LOG_FORMAT=text
LOG_LEVEL=INFO
# SENTRY_DSN=
# ENVIRONMENT=production

# DB connection pool sizing (Â§7). Defaults are fine for a single
# gateway + couple of workers; tune upward per replica count, or put
# PgBouncer in front of Postgres at the 10k-user tier instead.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Unchanged from v3 â€” see README.md for the full provider list.
HELIUS_API_KEY=
ALCHEMY_API_KEY=
DRPC_API_KEY=
QUICKNODE_RPC_URL=
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
KOL_PROVIDER_URL=
PREMIUM_BACKGROUND_SCHEDULERS_ENABLED=false
